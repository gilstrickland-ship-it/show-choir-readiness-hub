# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Branding (Constitution IX — single source is lib/brand.ts)
BRAND_NAME=
BRAND_DOMAIN=
BRAND_SUPPORT_EMAIL=
BRAND_EMAIL_FROM_NAME=

# AI packet parsing (Constitution IV — draft-only). Server-side only; the
# Anthropic client is lazy-initialized and never constructed at build/verify time.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-8 (the packet-parse model).
PACKET_PARSE_MODEL=

# Inngest (packet/parse and later jobs). When INNGEST_EVENT_KEY is absent, the
# packet upload runs the parse inline as a dev/pilot fallback.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
